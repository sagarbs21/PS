ENV=local
DATABASE_URL=postgresql+psycopg2://poojaseva:poojaseva@db:5432/poojaseva
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# OTP delivery: "email" (Resend HTTP API) or "stub" (returns the code in the response, dev only)
OTP_MODE=email

# Resend (https://resend.com) — create an API key. For testing you can send from
# onboarding@resend.dev; for production verify your own domain.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=PoojaSeva <onboarding@resend.dev>

# Comma-separated phone numbers granted the admin role on login
ADMIN_PHONES=+15551234567
